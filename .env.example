# Copy to .env and fill in. Never commit .env.
# Azure AI Document Intelligence (optional second extractor). Leave empty to skip it.
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
# prebuilt-read or prebuilt-layout
AZURE_DI_MODEL=prebuilt-read
# page caps; the free F0 tier allows 500 pages a month
AZURE_DI_RUN_PAGES=150
AZURE_DI_MONTH_PAGES=450
